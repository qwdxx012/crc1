<Page x:Class="Zadanie8.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 4">
    <StackPanel Margin="20">
        <TextBlock Text="Задача 4. Перестановка элементов массива" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                   Text="Дан массив целых чисел. Нужно поменять местами первый чётный и последний отрицательный элементы массива. Числа вводить через пробел, например: 3 -5 8 -2 7 4"/>

        <TextBlock Text="Введите числа через пробел:"/>
        <TextBox x:Name="txtInput" Width="450" HorizontalAlignment="Left" Margin="0,5,0,10"/>

        <Button x:Name="btnCalculate" Content="Выполнить" Width="120" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

        <TextBlock Text="Результат:" Margin="0,15,0,0"/>
        <TextBox x:Name="txtResult" Width="450" HorizontalAlignment="Left" Margin="0,5,0,0"
                 IsReadOnly="True" Background="#F0F0F0"/>
    </StackPanel>
</Page>
