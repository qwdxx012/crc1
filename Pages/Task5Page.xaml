<Page x:Class="Zadanie8.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Задача 5. Сортировка двумерного массива" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                       Text="Сгенерировать массив размером M столбцов и N строк со случайными числами от -10 до 10. Показать исходный массив, отсортировать его элементы по возрастанию и по убыванию, вывести результаты в двух таблицах. Найти максимальный и минимальный элементы."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Число строк (N):" VerticalAlignment="Center" Width="140"/>
                <TextBox x:Name="txtRows" Width="80"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Число столбцов (M):" VerticalAlignment="Center" Width="140"/>
                <TextBox x:Name="txtColumns" Width="80"/>
            </StackPanel>

            <Button x:Name="btnCalculate" Content="Выполнить" Width="120" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

            <TextBlock Text="Результат:" Margin="0,15,0,0"/>
            <TextBox x:Name="txtResult" Width="600" Height="300" HorizontalAlignment="Left" Margin="0,5,0,0"
                     IsReadOnly="True" Background="#F0F0F0"
                     FontFamily="Consolas" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
